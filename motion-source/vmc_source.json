"\u003c!doctype html>\n\u003chtml lang=\"zh-Hant\">\n  \u003chead>\n    \u003cmeta charset=\"utf-8\" />\n    \u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n    \u003ctitle>方格角色 VMC 接收\u003c/title>\n    \u003cstyle>\n      * {\n        box-sizing: border-box;\n      }\n      body {\n        margin: 0;\n        background: #131821;\n        color: #e6edf7;\n        font: 14px system-ui;\n        padding: 12px 12px 40px;\n      }\n      main {\n        max-width: 1050px;\n        margin: auto;\n      }\n      h1 {\n        font-size: 19px;\n        margin: 0 0 10px;\n      }\n      h2 {\n        font-size: 14px;\n        margin: 0 0 7px;\n      }\n      section {\n        background: #1b2330;\n        border: 1px solid #465570;\n        padding: 10px;\n        margin: 9px 0;\n      }\n      .row {\n        display: flex;\n        gap: 7px;\n        align-items: center;\n        flex-wrap: wrap;\n      }\n      button,\n      input {\n        font: inherit;\n        color: inherit;\n        background: #28364c;\n        border: 1px solid #465570;\n        border-radius: 0;\n        padding: 5px 7px;\n        min-height: 31px;\n      }\n      button {\n        cursor: pointer;\n      }\n      #code {\n        font: 22px monospace;\n        width: 280px;\n        color: #9bd8ff;\n      }\n      #barcode {\n        display: block;\n        width: min(100%, 480px);\n        height: auto;\n        background: #fff;\n        margin: 9px 0;\n      }\n      small,\n      .hint {\n        color: #b9cde7;\n        font-size: 12px;\n        line-height: 1.6;\n      }\n      #receiveStatus,\n      #previewInfo,\n      #frameInfo,\n      #faceInfo,\n      #swipeInfo {\n        font-size: 12px;\n        line-height: 1.7;\n        overflow-wrap: anywhere;\n      }\n      #receivecanvas {\n        display: block;\n        width: 100%;\n        height: clamp(220px, 48vh, 490px);\n        background: #000;\n      }\n      #swipeDirection {\n        font-size: 35px;\n        color: #9bd8ff;\n        min-height: 52px;\n      }\n      footer {\n        position: fixed;\n        bottom: 0;\n        left: 0;\n        right: 0;\n        height: 28px;\n        padding: 6px;\n        text-align: center;\n        font-size: 10px;\n        color: #96a4b7;\n        background: #131821;\n        border-top: 1px solid #465570;\n      }\n      dialog {\n        background: #192232;\n        color: #e6edf7;\n        border: 1px solid #526680;\n        width: min(400px, 94vw);\n        padding: 14px;\n      }\n      dialog::backdrop {\n        background: #000b;\n      }\n      #qrbox {\n        background: #fff;\n        padding: 6px;\n        margin: 9px 0;\n      }\n      #qrbox svg {\n        display: block;\n        width: 100%;\n        height: auto;\n      }\n      #qrcodeText {\n        font: 19px monospace;\n        text-align: center;\n        margin: 8px 0;\n      }\n      [hidden] {\n        display: none !important;\n      }\n      :disabled {\n        opacity: 0.55;\n      }\n    \u003c/style>\n  \u003cstyle>.vmc-nav, footer{display:none!important}body{padding-bottom:10px}\u003c/style>\u003c/head>\n  \u003cbody>\n    \u003cnav\n      class=\"vmc-nav\"\n      style=\"display: flex; gap: 12px; flex-wrap: wrap; padding: 8px 0; font-size: 12px\"\n    >\n      \u003ca style=\"color: #9bd8ff\" href=\"https://anshaer.github.io/VMC/\">專案首頁\u003c/a\n      >\u003ca style=\"color: #9bd8ff\" href=\"https://anshaer.github.io/VMC/transmit/\">共用手機／平板\u003c/a\n      >\u003ca style=\"color: #9bd8ff\" href=\"https://anshaer.github.io/VMC/docs/\">使用說明\u003c/a>\n    \u003c/nav>\n    \u003cmain>\n      \u003csection>\n        \u003ch2>多來源分區接收\u003c/h2>\n        \u003cp class=\"hint\">\n          最多 8 台使用同一碼。平板各選控制區域；同區先連線且資料新鮮者優先，3\n          秒未更新可切備援。這是控制分工，不是多鏡頭融合。\n        \u003c/p>\n        \u003cdiv id=\"sources\">\u003c/div>\n      \u003c/section>\n      \u003ch1>方格角色 VMC 接收\u003c/h1>\n      \u003csection>\n        \u003ch2>手機連線\u003c/h2>\n        \u003cdiv class=\"row\">\n          \u003cinput id=\"code\" type=\"text\" readonly aria-label=\"接收端連接碼\" />\n          \u003cbutton id=\"copycode\" disabled>複製碼\u003c/button>\n          \u003cbutton id=\"reconnect\">重新連線\u003c/button>\n          \u003cbutton id=\"newcode\">產生新碼\u003c/button>\n          \u003cbutton id=\"showqr\" disabled>顯示 QR\u003c/button>\n        \u003c/div>\n        \u003csvg id=\"barcode\" hidden aria-label=\"接收端一維碼\">\u003c/svg>\n        \u003cdiv id=\"barcodeNote\" class=\"hint\">正在產生連接碼…\u003c/div>\n        \u003cdiv id=\"receiveStatus\" role=\"status\" aria-live=\"polite\">\u003c/div>\n      \u003c/section>\n      \u003csection>\n        \u003ch2>動捕資訊\u003c/h2>\n        \u003ccanvas id=\"receivecanvas\" aria-label=\"黑底 VMC 骨架節點連線\"> \u003c/canvas>\n        \u003cdiv id=\"previewInfo\">等待動捕關鍵點\u003c/div>\n        \u003cdiv id=\"frameInfo\">等待手機傳送\u003c/div>\n        \u003cdiv id=\"faceInfo\">\u003c/div>\n      \u003c/section>\n      \u003csection>\n        \u003ch2>滑動方向\u003c/h2>\n        \u003cdiv id=\"swipeDirection\" aria-live=\"polite\">—\u003c/div>\n        \u003cdiv id=\"swipeInfo\">等待手機滑動\u003c/div>\n      \u003c/section>\n      \u003cp class=\"hint\">\n        手機開這版通用 VMC 傳輸頁，掃描上方一維碼或輸入文字碼。「顯示 QR」按下才會彈出\n        QR。此版先顯示實際動捕點線、VMC\n        骨架、面部數值及上／下／左／右方向，此頁是接收診斷工具，不含角色渲染；角色畫面需使用支援此連線協定的角色頁。\n      \u003c/p>\n    \u003c/main>\n    \u003cfooter>Copyright © 2026-2030 anshaer.com. All rights reserved.\u003c/footer>\n    \u003cdialog id=\"qrdialog\">\n      \u003ch2>手機掃描 QR\u003c/h2>\n      \u003cdiv id=\"qrbox\">\u003c/div>\n      \u003cdiv id=\"qrcodeText\">\u003c/div>\n      \u003cbutton id=\"qrclose\">關閉 QR\u003c/button>\n    \u003c/dialog>\n    \u003cscript id=\"peerjs-client\">\n      /* PeerJS 1.5.5, https://github.com/peers/peerjs\nCopyright (c) 2015 Michelle Bu and Eric Zhang, http://peerjs.com\n\n(The MIT License)\n\nPermission is hereby granted, free of charge, to any person obtaining\na copy of this software