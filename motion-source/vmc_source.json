 > 4096 ||\n            bytes[0] !== 65 ||\n            bytes[1] !== 87 ||\n            bytes[2] !== 1 ||\n            bytes[3] > 2 ||\n            bytes[4] > 1 ||\n            bytes[5] > 4\n          )\n            return null;\n          const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength),\n            aspect = view.getFloat32(8, false);\n          if (!Number.isFinite(aspect) || aspect \u003c 0.2 || aspect > 5) return null;\n          let face = null,\n            pose = null,\n            hands = { landmarks: [] },\n            at = 12,\n            seen = new Set(),\n            count = 0;\n          for (let i = 0; i \u003c bytes[5]; i++) {\n            if (at + 3 > bytes.length) return null;\n            let type = bytes[at++],\n              size = view.getUint16(at, false);\n            at += 2;\n            if (\n              type \u003c 1 ||\n              type > 4 ||\n              seen.has(type) ||\n              size > (type === 1 ? 128 : type === 2 ? 33 : 21) ||\n              at + size * 7 > bytes.length\n            )\n              return null;\n            seen.add(type);\n            let points = [],\n              ids = new Set();\n            for (let j = 0; j \u003c size; j++) {\n              let id = view.getUint16(at, false),\n                max = type === 1 ? 478 : type === 2 ? 33 : 21;\n              if (id >= max || ids.has(id)) return null;\n              ids.add(id);\n              points[id] = {\n                x: view.getUint16(at + 2, false) / 32767.5 - 0.5,\n                y: view.getUint16(at + 4, false) / 32767.5 - 0.5,\n                visibility: bytes[at + 6] / 255,\n              };\n              at += 7;\n              count++;\n            }\n            if (type === 1) face = { faceLandmarks: [points] };\n            else if (type === 2) pose = { landmarks: [points] };\n            else hands.landmarks[type - 3] = points;\n          }\n          if (at !== bytes.length) return null;\n          return {\n            face,\n            pose,\n            hands,\n            options: {\n              aspect,\n              mirror: !!bytes[4],\n              confidence: bytes[6] / 255,\n              mode: [\"face\", \"upper\", \"full\"][bytes[3]],\n              autoFit: true,\n            },\n            count,\n          };\n        } catch {\n          return null;\n        }\n      }\n\n      const VMC_REGIONS = {\n        all: [\"face\", \"torso\", \"leftArm\", \"rightArm\", \"leftHand\", \"rightHand\", \"legs\", \"root\"],\n        face: [\"face\"],\n        body: [\"torso\", \"leftArm\", \"rightArm\", \"leftHand\", \"rightHand\", \"legs\", \"root\"],\n        torso: [\"torso\"],\n        leftArm: [\"leftArm\"],\n        rightArm: [\"rightArm\"],\n        hands: [\"leftHand\", \"rightHand\"],\n        leftHand: [\"leftHand\"],\n        rightHand: [\"rightHand\"],\n        legs: [\"legs\"],\n        root: [\"root\"],\n      };\n      const VMC_REGION_LABELS = {\n        all: \"全部\",\n        face: \"面部＋頭部\",\n        body: \"身體＋肢體\",\n        torso: \"軀幹\",\n        leftArm: \"左手臂\",\n        rightArm: \"右手臂\",\n        hands: \"雙手掌／手指\",\n        leftHand: \"左手掌／手指\",\n        rightHand: \"右手掌／手指\",\n        legs: \"雙腿／腳\",\n        root: \"角色位移\",\n      };\n      function boneRegion(name) {\n        if (name === \"Head\" || name === \"LeftEye\" || name === \"RightEye\" || name === \"Jaw\")\n          return \"face\";\n        if (/^(Left|Right)(Hand|Thumb|Index|Middle|Ring|Little)/.test(name))\n          return name.startsWith(\"Left\") ? \"leftHand\" : \"rightHand\";\n        if (/^(Left|Right)(Shoulder|UpperArm|LowerArm)$/.test(name))\n          return name.startsWith(\"Left\") ? \"leftArm\" : \"rightArm\";\n        if (/^(Left|Right)(UpperLeg|LowerLeg|Foot|Toes)$/.test(name)) return \"legs\";\n        return \"torso\";\n      }\n      class VmcRegionReceiver extends VmcPairLink {\n        constructor(role, hooks) {\n          super(role, hooks);\n          this.sources = new Map();\n          this.routes = new Map();\n          this.routeSeq = 0;\n          this.current = null;\n          this.dirty = false;\n          this.lastMerge = -Infinity;\n          this.bodySeen = false;\n          this.shutting = false;\n          this.regionTimer = null;\n          this.sourceNumber = 0;\n        }\n        start(code = \"\") {\n          super.start(code);\n          clearInterval(this.pulse);\n          this.pulse = setInterval(() => {\n            const now = performance.now();\n            for (const s of this.sources.values())\n              if (s.link.ready) {\n                if (now - s.link.lastData > 15000) s.link.failed(\"心跳逾時\");\n                else s.link.send({ kind: \"ping\" });\n              }\n          }, 1000);\n          this.regionTimer = setInterval(() => this.mergeTick(), 33);\n          this.renderSources();\n        }\n        attach(c, epoch) {\n          if (this.stopped || epoch !== this.epoch) {\n            c.close();\n            return;\n          }\n          const id = c.peer || c.connectionId || String(++this.sourceNumber);\n          const old = this.sources.get(id);\n          if (old) old.link.dispose();\n          if (this.sources.size >= 8) {\n            c.close();\n            this.status(\"最多同時接收 8 台來源\");\n            return;\n          }\n          const s = {\n            id,\n            number: ++this.sourceNumber,\n            region: \"all\",\n            messages: null,\n            at: -Infinity,\n            link: null,\n            initializing: true,\n          };\n          const child = new VmcPairLink(\"receive\", {\n            status: () => {},\n            ready: () => {\n              this.ready = true;\n              this.status(\"WebRTC 多來源已連線\");\n              this.renderSources();\n            },\n            frame: (frame, packet) => {\n              if ((packet?.byteLength || 0) > 32768) return;\n              try {\n                const first = !s.messages;\n                s.messages = oscRead(packet);\n                if (!s.explicit) {\n                  const mode = s.messages.find((m) => m.address === \"/ANSHA/Motion/Mode\")?.args[0];\n                  s.region = mode === \"face\" ? \"face\" : \"all\";\n                }\n                s.at = performance.now();\n                this.bodySeen =\n                  this.bodySeen || s.messages.some((m) => m.address === \"/VMC/Ext/Root/Pos\");\n                this.dirty = true;\n                this.mergeTick();\n                if (first) this.renderSources();\n              } catch {}\n            },\n            preview: (p) => {\n              if (\n                VMC_REGIONS[s.region].includes(\"face\") &&\n                (!this.owners().face || this.owners().face === s)\n              )\n                this.hooks.preview?.(p);\n            },\n            swipe: (direction, seq) => {\n              if (this.routes.size >= 16) return;\n              const routed = ++this.routeSeq;\n              this.routes.set(routed, { s, seq, direction, at: performance.now() });\n              this.hooks.swipe?.(direction, routed);\n            },\n            disconnected: () => {\n              if (s.initializing || this.shutting) return;\n              if (this.sources.get(id) !== s) return;\n              this.sources.delete(id);\n              for (const [key, r] of this.routes) if (r.s === s) this.routes.delete(key);\n              this.ready = [...this.sources.values()].some((x) => x.link.ready);\n              this.dirty = true;\n              this.mergeTick(true);\n              this.renderSources();\n              if (!this.sources.size) this.hooks.disconnected?.();\n            },\n          });\n          s.link = child;\n          this.sources.set(id, s);\n          c.on(\"data\", (m) => {\n            if (m?.kind !== \"scope\" || !child.ready || !Object.hasOwn(VMC_REGIONS, m.region))\n              return;\n            s.region = m.region;\n            s.explicit = true;\n            s.messages = null;\n            s.at = -Infinity;\n            this.dirty = true;\n            this.renderSources();\n          });\n          child.attach(c, child.epoch);\n          s.initializing = false;\n          this.renderSources();\n        }\n        owners() {\n          const owners = {};\n          const now = performance.now();\n          for (const s of this.sources.values())\n            if (s.link.ready && s.messages && now - s.at \u003c 3000)\n              for (const region of VMC_REGIONS[s.region])\n                if (\n                  !owners[region] &&\n                  s.messages.some((m) =>\n                    region === \"root\"\n                      ? m.address === \"/VMC/Ext/Root/Pos\"\n                      : region === \"face\"\n                        ? m.address.startsWith(\"/VMC/Ext/Blend/\") ||\n                          (m.address === \"/VMC/Ext/Bone/Pos\" && boneRegion(m.args[0]) === \"face\")\n                        : m.address === \"/VMC/Ext/Bone/Pos\" && boneRegion(m.args[0]) === region,\n                  )\n                )\n                  owners[region] = s;\n          return owners;\n        }\n        mergeTick(force = false) {\n          if (this.shutting || this.stopped) return;\n          const now = performance.now();\n          let expired = false;\n          for (const s of this.sources.values())\n            if (s.messages && now - s.at >= 3000) {\n              s.messages = null;\n              expired = true;\n              this.dirty = true;\n            }\n          for (const [seq, r] of this.routes) if (now - r.at >= 3000) this.routes.delete(seq);\n          if (expired) this.renderSources();\n          if (!this.dirty || (!force && now - this.lastMerge \u003c 33)) return;\n          this.dirty = false;\n          this.lastMerge = now;\n          const owners = this.owners();\n          if (!Object.keys(owners).length) return;\n          const messages = oscRead(vmcEncode({}, 1, false, now / 1000)).filter(\n            (m) => m.address !== \"/VMC/Ext/OK\",\n          );\n          const face = owners.face;\n          let output = messages.filter((m) => m.address === \"/VMC/Ext/T\" || !face);\n          if (face)\n            output.push(\n              ...face.messages.filter(\n                (m) =>\n                  m.address.startsWith(\"/VMC/Ext/Blend/\") ||\n                  (m.address === \"/VMC/Ext/Bone/Pos\" && boneRegion(m.args[0]) === \"face\") ||\n                  m.address.startsWith(\"/ANSHA/Face/\"),\n              ),\n            );\n          if (!output.some((m) => m.address === \"/VMC/Ext/Bone/Pos\" && m.args[0] === \"Head\"))\n            output.push(\n              oscRead(vmcEncode({}, 1, false, 0)).find((m) => m.address === \"/VMC/Ext/Bone/Pos\"),\n            );\n          if (!output.some((m) => m.address === \"/VMC/Ext/Blend/Apply\"))\n            output.push({ address: \"/VMC/Ext/Blend/Apply\", types: \"\", args: [] });\n          if (this.bodySeen) {\n            const byName = new Map();\n            for (const [region, s] of Object.entries(owners)) {\n              if (region === \"face\" || region === \"root\") continue;\n              for (const m of s.messages)\n                if (m.address === \"/VMC/Ext/Bone/Pos\" && boneRegion(m.args[0]) === region)\n                  byName.set(m.args[0], m);\n            }\n            for (const [name, b] of Object.entries(MOBILE_BONES)) {\n              if (name === \"Head\") continue;\n              if (byName.has(name)) {\n                output.push(byName.get(name));\n                byName.delete(name);\n              } else\n                output.push({\n                  address: \"/VMC/Ext/Bone/Pos\",\n                  types: \"sfffffff\",\n                  args: [name, ...mvScale(b.p, 1.6), 0, 0, 0, 1],\n                });\n            }\n            output.push(...byName.values());\n            const root = owners.root?.messages.find((m) => m.address === \"/VMC/Ext/Root/Pos\");\n            output.push(\n              root || {\n                address: \"/VMC/Ext/Root/Pos\",\n                types: \"sfffffff\",\n                args: [\"root\", 0, 0, 0, 0, 0, 0, 1],\n              },\n            );\n          }\n          output.push(\n            { address: \"/VMC/Ext/OK\", types: \"iiii\", args: [1, 3, 0, 1] },\n            { address: \"/ANSHA/Motion/Mode\", types: \"s\", args: [this.bodySeen ? \"full\" : \"face\"] },\n          );\n          const packet = oscBundle(output.map((m) => oscMessage(m.address, m.types, m.args))),\n            frame = vmcDecode(packet);\n          if (frame) this.hooks.frame?.(frame, packet);\n        }\n        send(data) {\n          if (data?.kind === \"swipeAck\") {\n            const r = this.routes.get(data.seq);\n            if (!r || r.direction !== data.direction) return false;\n            this.routes.delete(data.seq);\n            return r.s.link.send({ ...data, seq: r.seq });\n          }\n          let sent = false;\n          for (const s of this.sources?.values() || []) sent = s.link.send(data) || sent;\n          return sent;\n        }\n        closeConnection() {\n          this.shutting = true;\n          clearInterval(this.regionTimer);\n          this.regionTimer = null;\n          for (const s of this.sources?.values() || []) s.link.dispose();\n          this.sources?.clear();\n          this.routes?.clear();\n          this.ready = false;\n          this.conn = null;\n          this.bodySeen = false;\n          this.dirty = false;\n          this.shutting = false;\n          this.hooks.disconnected?.();\n          this.renderSources();\n        }\n        renderSources() {\n          const element = document.getElementById(\"sources\");\n          if (!element) return;\n          element.replaceChildren();\n          const owners = this.owners();\n          if (!this.sources.size) {\n            element.textContent = \"等待來源；最多 8 台，共用同一連接碼。\";\n            return;\n          }\n          for (const s of this.sources.values()) {\n            const row = document.createElement(\"div\");\n            row.style.margin = \"5px 0\";\n            const active = Object.entries(owners)\n              .filter(([k, v]) => v === s)\n              .map(([k]) => VMC_REGION_LABELS[k] || k);\n            row.textContent =\n              \"來源 \" +\n              s.number +\n              \" · \" +\n              VMC_REGION_LABELS[s.region] +\n              \" · \" +\n              (!s.link.ready\n                ? \"握手中\"\n                : !s.messages\n                  ? \"等待新資料\"\n                  : active.length\n                    ? \"控制：\" + active.join(\"、\")\n                    : \"區域被優先來源占用\");\n            element.append(row);\n          }\n        }\n      }\n\n      const $ = (id) => document.getElementById(id);\n      let lastAt = 0,\n        lastStatsAt = 0,\n        lastFrameAt = -Infinity,\n        latestSkeleton = null,\n        latestPreview = null,\n        lastPreviewAt = -Infinity,\n        swipeTimer = null;\n      function clearSwipeInfo() {\n        clearTimeout(swipeTimer);\n        swipeTimer = null;\n        $(\"swipeDirection\").textContent = \"—\";\n        $(\"swipeInfo\").textContent = \"等待手機滑動\";\n      }\n      function clearMotionInfo() {\n        latestPreview = latestSkeleton = null;\n        lastPreviewAt = lastFrameAt = -Infinity;\n        lastAt = lastStatsAt = 0;\n        $(\"frameInfo\").textContent = \"等待手機傳送\";\n        $(\"faceInfo\").textContent = \"\";\n        drawReceiverMotion();\n      }\n      function clearExpiredInfo() {\n        const now = performance.now();\n        let changed = false;\n        if (latestPreview && now - lastPreviewAt >= 3000) {\n          latestPreview = null;\n          changed = true;\n        }\n        if (latestSkeleton && now - lastFrameAt >= 3000) {\n          latestSkeleton = null;\n          $(\"frameInfo\").textContent = \"等待手機傳送\";\n          $(\"faceInfo\").textContent = \"\";\n          changed = true;\n        }\n        if (changed) drawReceiverMotion();\n      }\n      const cleanupTimer = setInterval(clearExpiredInfo, 500);\n      function receiverStatus(text) {\n        $(\"receiveStatus\").textContent = text;\n      }\n      function drawReceiverMotion() {\n        if (latestPreview) {\n          drawLandmarkWire(\n            $(\"receivecanvas\"),\n            latestPreview.face,\n            latestPreview.pose,\n            latestPreview.hands,\n            latestPreview.options,\n          );\n          $(\"previewInfo\").textContent = latestPreview.count\n            ? \"實際動捕關鍵點：\" + latestPreview.count + \" 點\"\n            : \"未偵測到關節；請確認手機已開啟辨識並讓人入鏡\";\n          return;\n        }\n        if (latestSkeleton) {\n          drawSkeletonWire($(\"receivecanvas\"), latestSkeleton);\n          $(\"previewInfo\").textContent =\n            latestSkeleton.mode === \"face\" ? \"等待臉部關鍵點；請兩端更新\" : \"VMC 骨架預覽\";\n        } else {\n          resetWire($(\"receivecanvas\"), \"等待手機動捕資訊\");\n          $(\"previewInfo\").textContent = \"等待動捕關鍵點\";\n        }\n      }\n\n      function renderPairCode(code) {\n        $(\"code\").value = code;\n        $(\"showqr\").disabled = !code;\n        $(\"copycode\").disabled = !code;\n        const raw = code.replace(/-/g, \"\");\n        try {\n          window.JsBarcode($(\"barcode\"), raw, {\n            format: \"CODE128\",\n            width: 2,\n            height: 62,\n            margin: 14,\n            displayValue: false,\n            background: \"#ffffff\",\n            lineColor: \"#000000\",\n          });\n          $(\"barcode\").removeAttribute(\"hidden\");\n          $(\"barcodeNote\").textContent = \"一維碼 CODE128：手機掃描或手動輸入皆可\";\n        } catch (e) {\n          $(\"barcode\").setAttribute(\"hidden\", \"\");\n          $(\"barcodeNote\").textContent = \"一維碼產生失敗：\" + e.message;\n        }\n        if ($(\"qrdialog\").open) $(\"qrdialog\").close();\n        $(\"qrbox\").replaceChildren();\n      }\n      const receiverLink = new VmcRegionReceiver(\"receive\", {\n        status: receiverStatus,\n        code: renderPairCode,\n        preview: (preview) => {\n          latestPreview = preview;\n          lastPreviewAt = performance.now();\n          drawReceiverMotion();\n        },\n        disconnected: () => {\n          clearMotionInfo();\n          clearSwipeInfo();\n        },\n        frame: (frame, packet) => {\n          let now = performance.now();\n          \n          lastFrameAt = now;\n          let skeleton;\n          try {\n            skeleton = vmcSkeleton(packet);\n          } catch {\n            return;\n          }\n          latestSkeleton = skeleton;parent.postMessage({type:\"ansha-voxel-vmc-frame\",values:frame.values,skeleton},\"*\");\n          if (now - lastAt >= 33) {\n            drawReceiverMotion();\n            lastAt = now;\n          }\n          if (now - lastStatsAt > 150) {\n            $(\"frameInfo\").textContent =\n              \"模式：\" +\n              ({ face: \"面部\", upper: \"上半身\", full: \"全身\" }[skeleton.mode] || skeleton.mode) +\n              \" · \" +\n              Object.keys(skeleton.bones).length +\n              \" 骨骼\";\n            $(\"faceInfo\").textContent =\n              \"轉頭 \" +\n              frame.values.yaw.toFixed(2) +\n              \"　閉眼 \" +\n              frame.values.eyeBlinkLeft.toFixed(2) +\n              \"／\" +\n              frame.values.eyeBlinkRight.toFixed(2) +\n              \"　張嘴 \" +\n              frame.values.jawOpen.toFixed(2);\n            lastStatsAt = now;\n          }\n        },\n        swipe: (direction, seq) => {\n          clearTimeout(swipeTimer);\n          $(\"swipeDirection\").textContent = {\n            up: \"↑ 上\",\n            down: \"↓ 下\",\n            left: \"← 左\",\n            right: \"→ 右\",\n          }[direction];\n          $(\"swipeInfo\").textContent = \"\";\n          swipeTimer = setTimeout(clearSwipeInfo, 3000);\n          receiverLink.send({ kind: \"swipeAck\", direction, seq });\n        },\n      });\n      function showPairQR() {\n        if (!receiverLink.code) return;\n        try {\n          let qr = window.qrcode(0, \"M\");\n          qr.addData(formatPairCode(receiverLink.code));\n          qr.make();\n          $(\"qrbox\").innerHTML = qr.createSvgTag({ cellSize: 6, margin: 24, scalable: true });\n          $(\"qrcodeText\").textContent = formatPairCode(receiverLink.code);\n          $(\"qrdialog\").showModal();\n        } catch (e) {\n          receiverStatus(\"QR 產生失敗：\" + e.message);\n        }\n      }\n      $(\"showqr\").onclick = showPairQR;\n      $(\"qrclose\").onclick = () => $(\"qrdialog\").close();\n      $(\"copycode\").onclick = async () => {\n        $(\"code\").select();\n        try {\n          await navigator.clipboard.writeText($(\"code\").value);\n          receiverStatus(\"連接碼已複製\");\n        } catch {\n          $(\"code\").focus();\n          receiverStatus(\"請複製已選取的連接碼\");\n        }\n      };\n      $(\"reconnect\").onclick = () => receiverLink.start();\n      $(\"newcode\").onclick = () => {\n        receiverLink.code = \"\";\n        receiverLink.start();\n      };\n      window.addEventListener(\"resize\", () => drawReceiverMotion());\n      window.addEventListener(\"pagehide\", () => {\n        clearInterval(cleanupTimer);\n        clearMotionInfo();\n        clearSwipeInfo();\n        receiverLink.dispose();\n      });\n      resetWire($(\"receivecanvas\"), \"等待手機動捕資訊\");\n      receiverLink.start();\n    \u003c/script>\n  \u003c/body>\n\u003c/html>\n"